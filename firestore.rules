rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && 
      (request.auth.token.role == "admin" ||
       request.auth.token.role == "system-admin" || 
       request.auth.token.role == "nurse-admin");
    }
    
    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to read and write their own documents
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fields only the server (Admin SDK: Stripe webhook, admin routes) may set.
    // Letting users write these would let anyone make themselves admin or grant free access.
    function protectedProfileFields() {
      return ['role', 'betaActive', 'subscriptionStatus', 'activationSource',
              'betaActivatedAt', 'plan', 'stripeCustomerId', 'stripeSubscriptionId',
              'subscriptionId', 'isDemo'];
    }

    // Users can read their own profile and edit their own preferences, but never
    // their role or access flags.
    match /profiles/{profileId} {
      allow read: if isSignedIn() && request.auth.uid == profileId;
      allow create: if isSignedIn() && request.auth.uid == profileId
        && !request.resource.data.keys().hasAny(protectedProfileFields().removeAll(['betaActive']))
        && (!('betaActive' in request.resource.data) || request.resource.data.betaActive == false);
      allow update: if isSignedIn() && request.auth.uid == profileId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedProfileFields());
      allow delete: if false;
    }

    // Patients belong to the clinician who created them
    match /patients/{patientId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.ownerId);
      allow create: if isSignedIn() &&
        (request.auth.uid == request.resource.data.userId || request.auth.uid == request.resource.data.ownerId);
      allow update, delete: if isSignedIn() &&
        (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.ownerId);
    }

    // Top-level transcription docs are keyed by the clinician's uid
    match /transcriptions/{transcriptionId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == transcriptionId || request.auth.uid == resource.data.userId);
      allow write: if isSignedIn() && request.auth.uid == transcriptionId;
    }

    match /analytics/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Audit logs are append-only and must be written as yourself
    match /audit_logs/{auditLogId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    // SOAP Notes collection - allow users to read/write their own notes
    match /soapNotes/{noteId} {
      allow read: if request.auth != null && 
                   (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.uid);
      allow create: if request.auth != null && 
                     (request.auth.uid == request.resource.data.userId || request.auth.uid == request.resource.data.uid);
      allow update, delete: if request.auth != null && 
                             (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.uid);
    }

    // Transcriptions collection - allow users to read/write their own transcriptions
    match /transcriptions/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // === PDF records - allow users to read/write their own PDFs ===
    match /pdfs/{pdfId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.uid);
    }

    // (Optional) if PDFs are nested under SOAP notes
    match /soapNotes/{noteId}/pdfs/{pdfId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.uid);
    }
  }
}